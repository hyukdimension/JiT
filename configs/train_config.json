{
    "CONFIG_TYPE": "train",
    "CONFIG_VERSION": "1.0",
    "COMMON_CONFIG": "configs/common_config.json",

    "# --- 자주 바꾸는 값 ---": "",
    "batch_size": 23,
    "epochs": 10,
    "blr": 5e-5,
    "output_dir": "d:/output/jit/output_v04",
    "data_path": "d:/data/original/noise25",

    "# --- LR 스케줄 ---": "",
    "lr": null,
    "min_lr": 0.0,
    "lr_schedule": "constant",
    "warmup_epochs": 5,

    "# --- 정규화 ---": "",
    "weight_decay": 0.0,

    "# --- Diffusion 학습 전용 ---": "",
    "P_mean": -0.8,
    "P_std": 0.8,
    "label_drop_prob": 0.1,

    "# --- EMA ---": "",
    "ema_decay1": 0.9999,
    "ema_decay2": 0.9996,

    "# --- 데이터로더 ---": "",
    "num_workers": 0,
    "pin_mem": true,

    "# --- 로깅/저장 ---": "",
    "log_freq": 1,
    "save_last_freq": 5,
    "eval_freq": 40,
    "online_eval": false,

    "# --- 샘플링 (online_eval 시 사용) ---": "",
    "num_images": 50000,
    "gen_bsz": 256
}